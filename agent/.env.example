# Kopieer dit bestand naar .env en vul de waarden in.
# .env staat in .gitignore en wordt nooit gecommit.

# Dezelfde passphrase als waarmee je het dashboard ontgrendelt.
ENCRYPTION_PASSPHRASE=

# Fine-grained GitHub PAT met Contents: read and write op roelgeelen/ig-dashboard.
GITHUB_TOKEN=

# Je Instagram-gebruikersnaam. Nodig omdat het Accountcentrum om een profiel
# vraagt zodra er meerdere accounts aan je Meta-account hangen.
IG_USERNAME=

# Optioneel: aantal dagen tussen exports. Instagram staat er maximaal 1 per 4 dagen toe.
EXPORT_INTERVAL_DAYS=4
